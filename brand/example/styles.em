@DefineStyle(name: "card")
  background: @{token.card_background};
  border: 1px solid @{token.border};
  border-radius: 16px;
@/DefineStyle

@DefineStyle(name: "accent-link")
  color: @{token.accent};
  font-weight: 600;
@/DefineStyle

@DefineStyle(name: "muted")
  color: @{token.muted};
  font-size: 12px;
@/DefineStyle
