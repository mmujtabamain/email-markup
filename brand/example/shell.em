@Include("brand.em");

@Media("(max-width: 600px)")
  .stack-column { display: block !important; width: 100% !important; }
@/Media

<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head><body style="margin:0;padding:0;"><div style="background:@{token.background};padding:32px 14px;font-family:Quicksand,'Segoe UI',Arial,sans-serif;"><div style="max-width:600px;margin:0 auto;background:@{token.card_background};border-radius:16px;border:1px solid @{token.border};overflow:hidden;"><div style="padding:24px 36px;border-bottom:1px solid @{token.hairline};"><img src="@{token.logo_url}" alt="@{token.company_name}" height="22" style="display:block;border:0;height:22px;width:auto;" /></div><div style="padding:34px 36px;color:@{token.ink};font-size:15px;line-height:1.7;">@Slot(default);</div><div style="padding:26px 36px;background:@{token.footer_background};border-top:1px solid @{token.hairline};font-size:12px;color:@{token.muted};line-height:1.7;"><div style="font-weight:700;color:@{token.ink};font-size:14px;">@{token.company_name}</div><div style="margin-top:2px;">@{token.tagline}</div><div style="margin-top:10px;">@{token.company_address}</div><div style="margin-top:10px;">You're receiving this because it may be relevant to @{business.name}. Not interested? <a href="@{unsubscribe_url}" style="color:@{token.accent};font-weight:600;">Unsubscribe</a> &mdash; one click, no hard feelings.</div></div></div><div style="max-width:600px;margin:12px auto 0;text-align:center;font-size:11px;color:#b9b6c6;">&copy; @{token.year} @{token.company_name}</div></div></body></html>
