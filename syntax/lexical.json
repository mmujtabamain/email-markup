{
  "version": 2,
  "fileExtensions": [".em"],
  "sigil": "@",
  "namePattern": "[A-Z][A-Za-z0-9_]*",
  "lineComment": "@//",
  "blockComment": ["@*", "*@"],
  "escape": "@@",
  "rawBodies": ["Props", "Slots", "DefineStyle", "Media"],
  "propTypes": [
    "string",
    "int",
    "decimal",
    "number",
    "bool",
    "name",
    "url",
    "email",
    "color"
  ],
  "deferredParameterTypes": ["int", "decimal", "number", "bool", "name", "raw", "path", "condition"],
  "keywords": [
    "DefineComponent",
    "DefineStyle",
    "DefineToken",
    "Else",
    "For",
    "If",
    "Include",
    "Media",
    "Props",
    "Slot",
    "Slots",
    "Template"
  ],
  "unsupported": [".emt", "@Engine", "@[", "@Name["]
}
