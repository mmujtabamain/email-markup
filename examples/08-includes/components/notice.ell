@DefineComponent(name: "Notice")
  @Props
    title: string
  @/Props
  @Slots
    default: required
  @/Slots
  @Template
    <section style="padding:18px;background:#fffbeb;border:1px solid #f59e0b;color:#78350f;">
      <strong>@{title}</strong>
      <div style="margin-top:6px;">@Slot(default);</div>
    </section>
  @/Template
@/DefineComponent
