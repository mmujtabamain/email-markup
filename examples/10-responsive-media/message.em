@Heading Weekly summary @/Heading
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
  <tr>
    <td class="summary-column" style="width:50%;padding:16px;background:#ecfdf5;vertical-align:top;">
      <strong>@{summary.completed}</strong>
      <br>
      Completed
    </td>
    <td class="summary-column" style="width:50%;padding:16px;background:#eff6ff;vertical-align:top;">
      <strong>@{summary.in_progress}</strong>
      <br>
      In progress
    </td>
  </tr>
</table>
