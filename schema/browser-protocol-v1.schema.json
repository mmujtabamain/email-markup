{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://email-markup.dev/schema/browser-protocol-v1.schema.json",
  "title": "Email Markup browser worker protocol v1",
  "description": "Worker-safe, non-authoritative compiler assistance protocol. Native server emc must revalidate publication and delivery inputs.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "id": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "character"],
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source"],
      "properties": {
        "path": { "type": "string", "pattern": "^/.*\\.emt?$" },
        "source": { "type": "string", "maxLength": 1048576 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_path", "source"],
      "properties": {
        "entry_path": { "type": "string", "pattern": "^/.*\\.emt?$" },
        "source": { "type": "string", "maxLength": 1048576 },
        "files": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/file" } },
        "include_directories": { "type": "array", "items": { "type": "string", "pattern": "^/" }, "uniqueItems": true },
        "imports": { "type": "array", "items": { "type": "string", "pattern": "^/.*\\.em$" }, "uniqueItems": true },
        "shell": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "type": "object", "properties": { "path": { "type": "string", "pattern": "^/.*\\.em$" } } }
          ]
        },
        "engine": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "type": "object", "properties": { "path": { "type": "string", "pattern": "^/.*\\.emt$" } } }
          ]
        },
        "data": { "type": "object" },
        "context_schema": { "type": "object" },
        "output_context": { "enum": ["html", "subject"] },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "id", "method", "params"],
      "properties": {
        "protocol": { "const": "email-markup.browser" },
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "method": { "enum": ["capabilities", "analyze", "format", "complete", "hover", "signature"] },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "capabilities" } } },
          "then": { "properties": { "params": { "type": "object", "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "method": { "enum": ["analyze", "complete", "hover", "signature"] } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/workspace" } } }
        },
        {
          "if": { "properties": { "method": { "enum": ["complete", "hover", "signature"] } } },
          "then": { "properties": { "params": { "allOf": [{ "$ref": "#/$defs/workspace" }, { "type": "object", "required": ["position"], "properties": { "position": { "$ref": "#/$defs/position" } } }] } } }
        },
        {
          "if": { "properties": { "method": { "const": "format" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/file" } } }
        }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "compiler_version", "id", "ok", "result"],
      "properties": {
        "protocol": { "const": "email-markup.browser" },
        "version": { "const": 1 },
        "compiler_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "id": { "$ref": "#/$defs/id" },
        "ok": { "const": true },
        "result": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "compiler_version", "id", "ok", "error"],
      "properties": {
        "protocol": { "const": "email-markup.browser" },
        "version": { "const": 1 },
        "compiler_version": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            { "type": "null" }
          ]
        },
        "id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "stack": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
