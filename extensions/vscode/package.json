{
  "name": "email-markup-language",
  "displayName": "Email Markup Language Support",
  "description": "Language support and secure final-HTML preview for Email Markup documents.",
  "version": "1.1.0",
  "publisher": "email-markup-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Grammar highlighting remains available; the server, data loading, external paths, and preview are disabled."
    }
  },
  "activationEvents": [
    "onLanguage:email-markup",
    "onCommand:email-markup.preview"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "icons",
    "syntaxes",
    "language-configuration.json",
    "server",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-syntax.mjs",
    "compile": "npm run generate && tsc -p . && node scripts/build-extension.mjs",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "test:host": "npm run compile && node dist/test/runTest.js",
    "package": "npm run compile && npx @vscode/vsce package --allow-missing-repository"
  },
  "contributes": {
    "languages": [
      {
        "id": "email-markup",
        "aliases": [
          "Email Markup",
          "email-markup"
        ],
        "extensions": [
          ".em"
        ],
        "icon": {
          "light": "./icons/email-markup-light.svg",
          "dark": "./icons/email-markup-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "email-markup",
        "scopeName": "source.email-markup",
        "path": "./syntaxes/email-markup.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "source.css": "css"
        }
      },
      {
        "scopeName": "email-markup.injection",
        "path": "./syntaxes/email-markup.injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "source.css"
        ]
      }
    ],
    "configurationDefaults": {
      "[email-markup]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "commands": [
      {
        "command": "email-markup.preview",
        "title": "Email Markup: Open Secure Preview",
        "icon": "$(eye)"
      },
      {
        "command": "email-markup.previewWithData",
        "title": "Email Markup: Preview with JSON Data"
      },
      {
        "command": "email-markup.loadRemoteImages",
        "title": "Email Markup: Load Remote Preview Images"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "email-markup.preview",
          "when": "editorLangId == email-markup",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Email Markup",
      "properties": {
        "email-markup.server.path": {
          "type": "string",
          "default": "",
          "description": "Trusted-workspace override for the email-markup-lsp executable."
        },
        "email-markup.images.base64WarningBytes": {
          "type": "number",
          "default": 102400,
          "minimum": 1,
          "description": "Separate remote-image audit warning threshold before Base64 expansion. Ordinary language-server diagnostics never wait on network requests."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
